      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile currently follows **%1$@**. Continuing will make it follow **%2$@** instead: %3$@ will no longer receive matches played with this profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Cette fiche suit actuellement **%1$@**. Continuer la fera suivre **%2$@** à la place : %3$@ ne recevra plus les parties jouées avec cette fiche."
