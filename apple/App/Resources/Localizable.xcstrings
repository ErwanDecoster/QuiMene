    "Partage ta fiche pour que tes amis puissent te suivre. Suis un ami pour retrouver vos parties jouées ensemble dans son historique." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine Karte, damit deine Freunde dir folgen können. Folge einem Freund, um eure gemeinsam gespielten Partien in dessen Verlauf zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your profile so your friends can follow you. Follow a friend to find the matches you've played together in their history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu ficha para que tus amigos puedan seguirte. Sigue a un amigo para encontrar las partidas jugadas juntos en su historial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi la tua scheda in modo che i tuoi amici possano seguirti. Segui un amico per ritrovare le partite giocate insieme nella sua cronologia."
          }
        }
      }
    },
