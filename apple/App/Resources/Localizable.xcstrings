          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ficha sigue actualmente a **%1$@**. Continuar hará que siga a **%2$@** en su lugar: %3$@ ya no recibirá las partidas jugadas con esta ficha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
