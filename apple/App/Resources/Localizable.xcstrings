    "Le classement final sera calculé à partir des manches jouées. Cette action ne peut pas être annulée." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Endwertung wird anhand der gespielten Runden berechnet. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The final standings will be calculated from the rounds played. This action can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clasificación final se calculará a partir de las mangas jugadas. Esta acción no se puede deshacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
