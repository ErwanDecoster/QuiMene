    "%@ vient de valider une manche : vérifie avant de valider la tienne." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat gerade eine Runde bestätigt: prüfe, bevor du deine bestätigst."
