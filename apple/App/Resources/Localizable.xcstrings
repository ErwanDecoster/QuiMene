    "Plus personne ne pourra saisir ni lancer de partie. Les parties terminées restent dans l'historique de chacun." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand kann dann noch Punkte eintragen oder eine Partie starten. Beendete Partien bleiben im Verlauf aller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one will be able to enter scores or start a match anymore. Finished matches stay in everyone's history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie podrá introducir puntuaciones ni iniciar una partida. Las partidas terminadas se quedan en el historial de cada uno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno potrà più inserire punteggi né avviare una partita. Le partite terminate restano nella cronologia di tutti."
          }
        }
      }
    },
