    "Une session est en cours de partage sur %@. Continuer ici la remplacera : les personnes connectées verront cette partie à la place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft bereits eine geteilte Sitzung für %@. Hier fortzufahren ersetzt sie: verbundene Personen sehen stattdessen diese Partie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session is currently being shared for %@. Continuing here will replace it: connected people will see this match instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una sesión en curso de compartición en %@. Continuar aquí la reemplazará: las personas conectadas verán esta partida en su lugar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso una sessione di condivisione su %@. Continuare qui la sostituirà: le persone connesse vedranno questa partita al suo posto."
          }
        }
      }
    },
