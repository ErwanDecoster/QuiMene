    "Synchronisation iCloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Synchronisierung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Sync"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización de iCloud"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizzazione iCloud"
          }
        }
      }
    },
    "Synchronise les joueurs et les parties entre tes appareils via iCloud. Désactivée, l'app reste pleinement fonctionnelle en local. Le changement s'applique au prochain lancement de l'app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert Spieler und Partien über iCloud zwischen deinen Geräten. Deaktiviert bleibt die App lokal voll funktionsfähig. Die Änderung wird beim nächsten App-Start wirksam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncs players and matches across your devices via iCloud. When off, the app stays fully functional locally. The change takes effect the next time you launch the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza los jugadores y las partidas entre tus dispositivos mediante iCloud. Si está desactivada, la app sigue siendo totalmente funcional en local. El cambio se aplica en el próximo inicio de la app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza i giocatori e le partite tra i tuoi dispositivi tramite iCloud. Se disattivata, l'app resta pienamente funzionale in locale. La modifica si applica al prossimo avvio dell'app."
          }
        }
      }
    },
