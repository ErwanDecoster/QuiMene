    "Les personnes qui rejoignent ne peuvent qu'observer, quel que soit leur choix — ça ne change rien pour les contributeurs déjà connectés." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beitretende Personen können nur beobachten, unabhängig von ihrer Wahl — das ändert nichts für bereits verbundene Mitwirkende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People who join can only observe, whatever they choose — this changes nothing for contributors already connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas que se unan solo podrán observar, sea cual sea su elección — esto no cambia nada para los colaboradores ya conectados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che si uniscono possono solo osservare, qualunque sia la loro scelta — questo non cambia nulla per i collaboratori già connessi."
          }
        }
      }
    },
    "Les personnes qui rejoignent peuvent choisir d'observer ou de proposer des manches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
