    "%@ est déjà ton ami, sur la fiche « %@ »." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist bereits dein Freund, auf der Karte „%2$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is already your friend, on the “%2$@” player card."
