    "A fermé la manche" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat die Runde geschlossen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closed the round"
          }
        },
        "es" : {
          "stringUnit" : {
