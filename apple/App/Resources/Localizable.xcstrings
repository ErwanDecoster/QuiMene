    "Tu observes cette partie : seul le créateur saisit les scores." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du beobachtest diese Partie: Nur der Ersteller gibt die Punkte ein."
