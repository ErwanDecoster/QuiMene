    "·" : {
      "shouldTranslate" : false
    },
    "À scanner (bouton « Scanner un code » sur l'appareil qui rejoint) ou à saisir — aucune connexion Wi-Fi commune n'est nécessaire, juste une connexion Internet des deux côtés." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Scannen (Schaltfläche „Code scannen“ auf dem beitretenden Gerät) oder zur Eingabe — es ist keine gemeinsame WLAN-Verbindung nötig, nur eine Internetverbindung auf beiden Seiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scan (“Scan a code” button on the joining device) or to type in — no shared Wi-Fi connection is needed, just an internet connection on both sides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear (botón «Escanear un código» en el dispositivo que se une) o para introducir — no se necesita ninguna conexión Wi-Fi común, solo una conexión a Internet en ambos lados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da scansionare (pulsante «Scansiona un codice» sul dispositivo che si unisce) o da inserire — non è necessaria alcuna connessione Wi-Fi comune, solo una connessione Internet su entrambi i lati."
          }
        }
      }
    },
