        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ just confirmed a round: check before confirming yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acaba de validar una ronda: revisa antes de validar la tuya."
