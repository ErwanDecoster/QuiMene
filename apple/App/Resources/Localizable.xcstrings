    "Cette fiche suit actuellement **%@**. Continuer la fera suivre **%@** à la place : %@ ne recevra plus les parties jouées avec cette fiche." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Karte folgt derzeit **%1$@**. Fortfahren lässt sie stattdessen **%2$@** folgen: %3$@ erhält die mit dieser Karte gespielten Partien nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
