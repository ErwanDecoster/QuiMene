    "Automatique : les joueurs les plus actifs (nombre de parties jouées) en premier. Manuel : réordonne-les toi-même dans l'onglet Joueurs." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch: die aktivsten Spieler (Anzahl gespielter Partien) zuerst. Manuell: ordne sie selbst im Tab „Spieler“ neu an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic: your most active players (by matches played) come first. Manual: reorder them yourself in the Players tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático: los jugadores más activos (número de partidas jugadas) primero. Manual: reordénalos tú mismo en la pestaña Jugadores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico: prima i giocatori più attivi (numero di partite giocate). Manuale: riordinali tu stesso nella scheda Giocatori."
          }
        }
      }
    },
